// Studio 26/27 — data model
//
// Deliberately portable: no SQLite-specific types are used, so migrating to
// Postgres is a `provider` + `DATABASE_URL` change and `prisma migrate dev`.
// Enums are modelled as String + a const union in lib/types.ts for the same
// reason (SQLite has no native enum; Postgres would accept either).

generator client {
  provider      = "prisma-client-js"
  // The app runs from a USB stick on both a Mac (Apple Silicon) and a Windows
  // laptop, so the engine for each is generated — "native" covers whichever
  // machine is doing the build.
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A university course. Progress weights are per-course and sum to 100
/// across the categories that actually exist for that course (see
/// lib/progress.ts — absent categories auto-rescale).
model Course {
  id           String  @id @default(cuid())
  code         String  @unique // e.g. COMPSCI5113
  name         String
  shortName    String // compact label for charts/badges, e.g. "FP"
  colour       String // hex, drawn from the DESIGN.md course palette
  archived     Boolean @default(false)
  position     Int     @default(0)
  /// 1 = semester 1, 2 = semester 2, 3 = runs all year.
  /// Semester-2 courses stay hidden until SEMESTER_2_VISIBLE_FROM (lib/types.ts).
  semester     Int     @default(1)
  /// When on, every lecture gains an unticked "Revised" part, re-opening the
  /// course for exam revision without losing the attendance/notes history.
  revisionMode Boolean @default(false)

  // Progress weights out of 100. Exams are deliberately excluded from the
  // bar (they resolve only at the very end of the year) and surface as a
  // separate readiness/countdown card instead.
  lectureWeight    Int @default(35)
  labWeight        Int @default(0)
  assessmentWeight Int @default(65)

  slots    ScheduleSlot[]
  tasks    Task[]
  sessions SessionCourse[]
  events   Event[]
  meetings Meeting[]
  papers   Paper[]

  /// Link to the code repository (the project course). GitHub integration
  /// will build on this later.
  repoUrl     String?
  /// The course's Moodle page, opened straight from the course header.
  moodleUrl   String?
  /// Expected hours of work, for the pace tracker (40 credits ≈ 400h).
  hoursTarget Int?
  /// The dissertation project, which gets the /project workspace.
  isProject   Boolean @default(false)
  /// Credits the course is worth. Overall progress is weighted by these.
  credits     Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A recurring timetable entry, used to generate Task instances week by week.
/// Kept after generation so the timetable can be re-run or extended.
model ScheduleSlot {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind      String // LECTURE | LAB | SEMINAR
  dayOfWeek Int // 1 = Monday ... 7 = Sunday
  startMin  Int // minutes from midnight, e.g. 600 = 10:00
  endMin    Int
  location  String?

  @@index([courseId])
}

/// Everything you can tick off: lecture instances, labs, coursework, quizzes,
/// exams, and anything ad-hoc you add yourself.
model Task {
  id       String  @id @default(cuid())
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  kind  String // LECTURE | LAB | SEMINAR | COURSEWORK | QUIZ | EXAM | OTHER
  notes String?

  /// When it happens / is due. `dueAt` is the deadline or class start time.
  dueAt     DateTime?
  /// Set for timetabled classes so the home page can show "today's classes"
  /// with real times; null for deadline-only tasks.
  startMin  Int?
  endMin    Int?
  /// Monday of the teaching week this instance belongs to (timetabled tasks).
  weekStart DateTime?

  /// Grade weight as a percentage of the final course mark, where known.
  /// Null means "unweighted" and the task is equal-weighted among its peers.
  gradeWeight Float?

  /// Exam diet label, e.g. "December 2026" / "April/May 2027". Exams often
  /// have no fixed date yet, so this carries the information dueAt cannot.
  examDiet String?

  priority  Int     @default(0) // 0 normal, 1 high
  cancelled Boolean @default(false)

  /// Typed lecture notes, as markdown. Rendered in-app and exported to PDF.
  notesMd       String?
  /// Where the handwritten notes physically live: which notebook (by cover
  /// design — Space / Physics / Computing) and which pages.
  notebook      String?
  notebookPages String?

  /// Google Calendar event id, set once this task has been pushed across, so
  /// a second push updates the event rather than duplicating it.
  calendarEventId String?

  /// Planned start, for tasks drawn as bars on the project timeline. Tasks
  /// without one are drawn as a point on their due date.
  startsAt DateTime?

  /// Set when the task was created from a meeting's action items.
  fromMeetingId String?
  fromMeeting   Meeting?      @relation("MeetingActions", fields: [fromMeetingId], references: [id], onDelete: SetNull)
  /// Meetings this task is prep for (the same advisory "do this first" idea
  /// as task dependencies).
  prepFor       MeetingPrep[]
  attachments   Attachment[]
  /// Denormalised completion stamp. Truth lives in TaskItem; this is set when
  /// every item is done (or, for item-less tasks, when ticked directly).
  doneAt        DateTime?

  items        TaskItem[]
  /// Tasks this one depends on — advisory only, never blocking.
  dependsOn    TaskDependency[] @relation("Dependent")
  dependents   TaskDependency[] @relation("Prerequisite")
  sessionLinks SessionTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([dueAt])
  @@index([weekStart])
  @@index([kind])
}

/// A checklist part of a task. Lectures get Attendance / Typed Notes /
/// Handwritten Notes; labs get Attendance / Lab Completion; coursework gets
/// whatever subtasks you create.
model TaskItem {
  id       String    @id @default(cuid())
  taskId   String
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label    String
  position Int       @default(0)
  doneAt   DateTime?

  @@index([taskId])
}

/// Advisory prerequisite edge: "these should be done before that".
/// Never enforced — completing a task early is always allowed.
model TaskDependency {
  id             String @id @default(cuid())
  dependentId    String
  dependent      Task   @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Task   @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

/// A completed study session, created when the global timer is stopped.
model Session {
  id String @id @default(cuid())

  name       String
  startedAt  DateTime
  endedAt    DateTime
  /// Final, possibly adjusted-down duration in minutes. This — not the
  /// wall-clock difference — is what every statistic uses.
  minutes    Int
  /// Raw wall-clock minutes before adjustment, kept for honesty in stats.
  rawMinutes Int
  /// Self-reported focus, 0–100.
  focus      Int
  notes      String?
  /// Where you studied - one of STUDY_LOCATIONS ("coffee" | "library" | ...).
  location     String?
  /// Free-text place, only when location is "other" (e.g. "Train").
  locationNote String?

  /// True when Spotify capture was active for this session. A tracked session
  /// with no tracks means "studied in silence"; an untracked one means "we
  /// don't know" — so only tracked sessions enter music-vs-silence stats.
  musicTracked Boolean @default(false)

  courses SessionCourse[]
  tasks   SessionTask[]
  tracks  SessionTrack[]

  createdAt DateTime @default(now())

  @@index([startedAt])
}

/// Many-to-many: a session can cover several subjects, each with its own
/// slice of the session's time. The slices always sum to Session.minutes —
/// see lib/split.ts, which apportions them with largest-remainder rounding
/// so no minute is ever lost or double-counted.
model SessionCourse {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// This subject's share of the session, in minutes.
  minutes   Int     @default(0)

  @@id([sessionId, courseId])
  @@index([courseId])
}

/// Optional link from a session to the specific tasks worked on.
model SessionTask {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([sessionId, taskId])
  @@index([taskId])
}

/// Singleton (id is always "singleton") holding the running timer, so the
/// timer is server-side state and survives reloads, tab closes and crashes.
model ActiveTimer {
  id        String   @id @default("singleton")
  startedAt DateTime
  /// Optional pre-filled name typed before/while the timer runs.
  draftName String?
}

/// Google OAuth tokens (id is always "singleton").
///
/// Single-user app on one machine, so tokens live in the database rather than
/// a session — they survive restarts and there is no second user to isolate.
model GoogleAuth {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  /// When the current access token stops working; refreshed on demand.
  expiresAt    DateTime
  scope        String
  email        String?
  /// Which calendar events get written to. "primary" unless changed.
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A uni event that isn't a piece of work — a supervisor meeting, a talk, a
/// careers fair. Lives on the calendar, can be tied to a course, and can be
/// pushed to Google. One-off by design.
model Event {
  id       String   @id @default(cuid())
  title    String
  startAt  DateTime
  endAt    DateTime
  allDay   Boolean  @default(false)
  location String?
  notes    String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  /// Google event id once synced — a second sync updates rather than duplicates.
  calendarEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([courseId])
}

/// Spotify OAuth tokens (id is always "singleton"). Read-only access to what's
/// currently playing — no playback control.
model SpotifyAuth {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  displayName  String?
  /// Granted scopes — listening history needs user-read-recently-played,
  /// which connections made before 18 Sep 2026 don't have.
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Something that played during a study session — a track or podcast episode —
/// with an estimate of how long it actually played within the session.
model SessionTrack {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  spotifyId String?
  kind      String // "track" | "episode"
  title     String
  /// Primary artist (or show name for an episode) — what stats group by.
  artist    String
  /// Every credited artist, for display.
  artists   String
  album     String?
  imageUrl  String?
  url       String?

  startedAt DateTime
  /// Minutes of this play that fell inside the session.
  minutes   Float

  @@index([sessionId])
  @@index([artist])
}

/// A now-playing reading taken while the timer runs. Raw material: folded
/// into SessionTracks when the session is logged, then deleted.
model ListeningSample {
  id         String   @id @default(cuid())
  sampledAt  DateTime @default(now())
  spotifyId  String?
  kind       String
  title      String
  artist     String
  artists    String
  album      String?
  imageUrl   String?
  url        String?
  durationMs Int
  progressMs Int
  isPlaying  Boolean

  @@index([sampledAt])
}

/// A supervisor meeting (or any project meeting). One-off: supervisor slots
/// move week to week. Carries prep tasks, an agenda, notes, and action items
/// that become tasks.
model Meeting {
  id       String   @id @default(cuid())
  title    String
  startAt  DateTime
  endAt    DateTime
  location String?
  /// Markdown. Can be drafted automatically from work since the last meeting.
  agenda   String?
  /// Markdown, written during or after the meeting.
  notes    String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  prep    MeetingPrep[]
  actions Task[]        @relation("MeetingActions")

  calendarEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
}

/// "Do this before the meeting" — advisory, never blocking.
model MeetingPrep {
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([meetingId, taskId])
  @@index([taskId])
}

/// A paper (or article, book, thesis) read for research.
model Paper {
  id      String  @id @default(cuid())
  title   String
  /// "Hu, E.; Shen, Y.; …" — stored as a list joined with "; ".
  authors String
  year    Int?
  venue   String?
  url     String?
  doi     String?
  arxivId String?
  /// article | inproceedings | preprint | book | thesis | misc
  kind    String  @default("article")
  /// to-read | reading | read
  status  String  @default("to-read")
  /// Comma-separated.
  tags    String?
  /// Markdown.
  notes   String?
  /// When the notes were last written - blank until notes are first saved.
  notesAt DateTime?
  /// Stable citation key for BibTeX, e.g. hu2021lora.
  citeKey String  @unique

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

/// A file attached to a task - lecture slides, a handout, a marked script.
/// The bytes live next to the database (data/uploads); only the record is here.
model Attachment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// What it was called when uploaded, shown in the UI.
  filename String
  /// What it's called on disk - never trusted user input.
  storedName String
  mime       String
  /// Bytes.
  size       Int

  createdAt DateTime @default(now())

  @@index([taskId])
}

/// App-wide preferences. One row, id "singleton".
model Preference {
  id String @id @default("singleton")

  /// "auto" (dark on a schedule) | "light" | "dark"
  theme String @default("auto")
  /// Hour the automatic dark window opens and closes, local time.
  darkFrom Int @default(21)
  darkTo   Int @default(7)

  updatedAt DateTime @updatedAt
}
